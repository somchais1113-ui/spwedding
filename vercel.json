{
  "framework": null,
  "buildCommand": "node tools/build-web.cjs",
  "outputDirectory": "public",
  "functions": {
    "api/rsvp.js": {
      "maxDuration": 30
    },
    "api/wishes.js": {
      "maxDuration": 60
    },
    "api/wish-render.js": {
      "maxDuration": 300,
      "includeFiles": [
        "assets/templates/**",
        "assets/fonts/**",
        "js/wish-export.js",
        "js/wish-source.js"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/card",
      "destination": "/share.html"
    },
    {
      "source": "/share",
      "destination": "/share.html"
    },
    {
      "source": "/share/",
      "destination": "/share.html"
    }
  ]
}